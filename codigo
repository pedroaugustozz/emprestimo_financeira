algoritmo "emprestimo_financeira"

var
   renda, valorDesejado, parcela, seguro, totalParcela : real
   idade : inteiro

inicio

   escreva("Digite a renda do cliente: ")
   leia(renda)

   escreva("Digite a idade do cliente: ")
   leia(idade)

   escreva("Digite o valor desejado do emprestimo: ")
   leia(valorDesejado)


   se renda > 2500 entao
      parcela <- renda * 0.30

   senao
      se renda > 2000 entao
         parcela <- renda * 0.20

      senao
         se renda > 1500 entao
            parcela <- renda * 0.15

         senao
            parcela <- 0
         fimse
      fimse
   fimse


   se parcela > 0 entao


      se (idade >= 18) e (idade <= 29) entao
         seguro <- parcela * 0.05

      senao
         se (idade >= 30) e (idade <= 44) entao
            seguro <- parcela * 0.07

         senao
            se (idade >= 45) e (idade <= 60) entao
               seguro <- parcela * 0.10

            senao
               se idade > 60 entao
                  seguro <- parcela * 0.15

               senao
                  seguro <- 0
               fimse
            fimse
         fimse
      fimse

      totalParcela <- parcela + seguro

      escreval("Valor maximo da parcela: R$ ", parcela:0:2)
      escreval("Valor do seguro: R$ ", seguro:0:2)
      escreval("Total da parcela com seguro: R$ ", totalParcela:0:2)

   senao

      escreval("Emprestimo nao aprovado!")
      escreval("Renda insuficiente.")

   fimse

fimalgoritmo
